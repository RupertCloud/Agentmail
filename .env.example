# ---------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8080

# The domain the platform itself owns. DKIM for hosted agent addresses is held
# here, so this must be a domain you control.
AGENTMAIL_DOMAIN=agentmail.example
# Namespace hosted agent mailboxes are allocated under.
AGENTMAIL_AGENT_DOMAIN=agents.agentmail.example
# Base for unsubscribe and tracking links; must be publicly reachable.
AGENTMAIL_PUBLIC_URL=https://api.agentmail.example

# Signs unsubscribe tokens and authenticates the inbound ingest endpoint.
# Generate with: openssl rand -base64 32
AGENTMAIL_SECRET=

# ----------------------------------------------------------------- store
# memory (default, non-durable) or postgres
AGENTMAIL_STORE=memory
# DATABASE_URL=postgres://user:password@host:5432/agentmail

# -------------------------------------------------------------- provider
# memory (default, sends nothing) or ses
AGENTMAIL_PROVIDER=memory

# Required when AGENTMAIL_PROVIDER=ses.
AWS_REGION=eu-west-1
# SES does not return ARNs on create, so tenant association builds them.
# Find it with: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=

# Credentials. Prefer an instance role, task role or IRSA in production and
# leave these unset; the SDK's default provider chain will find them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --------------------------------------------------------------- limits
AGENTMAIL_INITIAL_DAILY_LIMIT=100
AGENTMAIL_MAX_HOPS=10
AGENTMAIL_MAX_THREAD_RATE=30
AGENTMAIL_MAX_DELEGATION_DEPTH=5
AGENTMAIL_LEASE_SECONDS=60
AGENTMAIL_MAX_WAIT_SECONDS=60
AGENTMAIL_MAX_SEND_ATTEMPTS=5
